# Sanity — public identifiers, safe to commit. Overridable for a fork or a
# staging dataset; the app falls back to these when unset.
NEXT_PUBLIC_SANITY_PROJECT_ID=xom53qc4
NEXT_PUBLIC_SANITY_DATASET=production

# Contact form delivery (https://resend.com).
# Without BOTH of these the form validates normally but refuses to pretend it
# sent anything — it tells the visitor to email directly instead.
# RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be an address on a domain verified in Resend. Not Jose's inbox — that is
# the recipient, and it is set in code.
# CONTACT_FROM_EMAIL=portfolio@jpulidev.com
